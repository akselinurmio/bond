{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "paths": {
      "components/*": ["./src/components/*"],
      "generated/*": ["./src/generated/*"],
      "layouts/*": ["./src/layouts/*"],
      "lib/*": ["./src/lib/*"],
      "styles/*": ["./src/styles/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
