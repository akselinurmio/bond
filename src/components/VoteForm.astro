---
interface Props {
  actorId: number;
  actorName: string;
  language: "en" | "fi";
  votes: number;
}

const { actorId, actorName, language, votes } = Astro.props;

const lastName = actorName.trim().split(" ").at(-1);
const buttonText = `${lastName} ${language === "fi" ? "on mun lemppari" : "is my favorite"}`;
const formattedVotes = `${votes.toLocaleString(language)} ${
  language === "fi"
    ? votes === 1
      ? "ääni"
      : "ääntä"
    : votes === 1
      ? "vote"
      : "votes"
}`;
---

<form
  class="vote-form"
  data-actor-id={actorId}
  data-initial-votes={votes}
  data-language={language}
>
  <p class="vote-count">{formattedVotes}</p>
  <input type="hidden" name="id" value={actorId} />
  <button type="submit">{buttonText}</button>
</form>

<script>
  import { $votedActor, clearVotedActor, markAsVoted } from "lib/vote-store";

  document.querySelectorAll<HTMLFormElement>(".vote-form").forEach((form) => {
    const button = form.querySelector("button")!;
    const countEl = form.querySelector(".vote-count")!;
    const actorId = Number(form.dataset.actorId);
    const language = form.dataset.language;
    let votes = Number(form.dataset.initialVotes);

    $votedActor.subscribe((votedActor) => {
      button.disabled = votedActor != null;
    });

    function renderVoteCount(count: number): void {
      countEl.textContent = `${count.toLocaleString(language)} ${
        language === "fi"
          ? count === 1
            ? "ääni"
            : "ääntä"
          : count === 1
            ? "vote"
            : "votes"
      }`;
    }

    function applyOptimisticVote(): void {
      markAsVoted(actorId);
      votes++;
      renderVoteCount(votes);
    }

    function revertOptimisticVote(): void {
      votes--;
      renderVoteCount(votes);
      clearVotedActor();
    }

    form.addEventListener("submit", async (e) => {
      if ($votedActor.get() !== null) {
        e.preventDefault();
        return;
      }

      e.preventDefault();
      applyOptimisticVote();

      try {
        const res = await fetch("/api/vote", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await res.json();

        if (!data.success) {
          throw new Error("Vote failed");
        }

        renderVoteCount(data.votes);
        votes = data.votes;
      } catch (err) {
        console.error(err);
        revertOptimisticVote();
      }
    });
  });
</script>
