---
import { getCollection, type CollectionEntry } from "astro:content";
import LangLayout from "layouts/LangLayout.astro";
import VoteForm from "components/VoteForm.astro";
import { getBondActorUrl } from "lib/actor-routes";
import { getVotesForActor } from "lib/votes";
import { Temporal } from "temporal-polyfill";
import { stripTrailingSlash } from "lib/url-utils";

interface Props {
  actor: CollectionEntry<"actors">;
  language: "en" | "fi";
}

const { actor, language } = Astro.props;
const localizedActor = actor.data.locales[language];

const title = localizedActor.name;
const canonical = stripTrailingSlash(
  getBondActorUrl(actor.data.tmdbId, localizedActor.slug, language),
);
const alternates = {
  en: stripTrailingSlash(
    getBondActorUrl(actor.data.tmdbId, actor.data.locales.en.slug, "en"),
  ),
  fi: stripTrailingSlash(
    getBondActorUrl(actor.data.tmdbId, actor.data.locales.fi.slug, "fi"),
  ),
};
const backLabel =
  language === "fi" ? "Takaisin etusivulle" : "Back to the front page";

function formatDate(isoDate: string) {
  return {
    iso: isoDate,
    formatted: Temporal.PlainDate.from(isoDate).toLocaleString(
      language === "en" ? "en-GB" : language,
      { dateStyle: "long" },
    ),
  };
}

const birthday = actor.data.birthday ? formatDate(actor.data.birthday) : null;
const deathday = actor.data.deathday ? formatDate(actor.data.deathday) : null;
const isDeceased = !!actor.data.deathday;
const datesHtml = birthday
  ? `(${!deathday ? (language === "fi" ? "s.\u00a0" : "born ") : ""}<time datetime="${birthday.iso}">${birthday.formatted}</time>${deathday ? ` \u2013 <time datetime="${deathday.iso}">${deathday.formatted}</time>` : ""})`
  : null;
const votes = await getVotesForActor(actor.data.tmdbId);
const movieCreditsByTmdbId = new Map(
  localizedActor.movieCredits.map((credit) => [credit.tmdbId, credit]),
);
const bondFilms = (await getCollection("bondFilms"))
  .toSorted((a, b) => a.data.listOrder - b.data.listOrder)
  .flatMap((film) => {
    const credit = movieCreditsByTmdbId.get(film.data.tmdbId);
    return credit ? [{ credit, film }] : [];
  });
const filmographyLabel = language === "fi" ? "Elokuvat" : "Films";
const introFilmCount =
  language === "fi"
    ? bondFilms.length === 1
      ? "yhdessä Bond-elokuvassa"
      : `${bondFilms.length} Bond-elokuvassa`
    : bondFilms.length === 1
      ? "one film"
      : `${bondFilms.length} films`;
---

<LangLayout
  title={title}
  canonical={canonical}
  alternates={alternates}
  localePaths={{
    en: `bonds/${actor.data.tmdbId}/${actor.data.locales.en.slug}`,
    fi: `bonds/${actor.data.tmdbId}/${actor.data.locales.fi.slug}`,
  }}
>
  <article class="actor-page">
    <a href="/" class="back-link">&larr; {backLabel}</a>

    <div class="actor-header">
      {
        actor.data.profileImage ? (
          <img
            alt={localizedActor.name}
            src={actor.data.profileImage.src}
            srcset={actor.data.profileImage.srcset}
            sizes="185px"
            width="185"
            height="278"
            class="actor-image"
          />
        ) : null
      }
      <div class="actor-info">
        <h1 translate="no">{localizedActor.name}</h1>
        <p class="actor-intro">
          <span translate="no">{localizedActor.name}</span>
          {datesHtml && <Fragment set:html={` ${datesHtml}`} />}
          {
            language === "fi"
              ? isDeceased
                ? ` esiintyi James Bondina ${introFilmCount}.`
                : ` on esiintynyt James Bondina ${introFilmCount}.`
              : isDeceased
                ? ` appeared as James Bond in ${introFilmCount}.`
                : ` has appeared as James Bond in ${introFilmCount}.`
          }
        </p>
        <VoteForm
          actorId={actor.data.tmdbId}
          actorName={localizedActor.name}
          language={language}
          votes={votes}
        />
      </div>
    </div>

    {
      bondFilms.length > 0 ? (
        <section class="filmography">
          <h2>{filmographyLabel}</h2>
          <ul class="filmography-list">
            {bondFilms.map(({ credit, film }) => {
              const localizedFilm = film.data.locales[language];

              return (
                <li class="film-card">
                  {film.data.posterImage ? (
                    <img
                      alt={localizedFilm.title}
                      src={film.data.posterImage.src}
                      srcset={film.data.posterImage.srcset}
                      sizes="185px"
                      width="185"
                      height="277"
                      class="film-poster"
                      loading="lazy"
                    />
                  ) : (
                    <div class="film-poster-placeholder" />
                  )}
                  <strong class="film-title">{localizedFilm.title}</strong>
                  {film.data.releaseYear ? (
                    <div class="film-year">
                      <time>{film.data.releaseYear}</time>
                    </div>
                  ) : null}
                  {credit.character ? (
                    <div class="film-character">{credit.character}</div>
                  ) : null}
                </li>
              );
            })}
          </ul>
        </section>
      ) : null
    }
  </article>
</LangLayout>

<style>
  .actor-page {
    display: grid;
    gap: 2rem;
  }

  .back-link {
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }

  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
  }

  .actor-header {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 40rem) {
    .actor-header {
      grid-template-columns: auto 1fr;
    }
  }

  .actor-image {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .actor-info {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    text-wrap: pretty;
  }

  .actor-info h1 {
    margin: 0;
  }

  .actor-intro {
    margin: 0;
  }

  .filmography h2 {
    margin: 0 0 1rem;
  }

  .filmography-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
    grid-auto-rows: auto auto auto auto 1rem;
    column-gap: 1rem;
    row-gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .film-card {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
  }

  .film-poster {
    grid-row: 1;
    display: block;
    max-width: 100%;
    height: auto;
    aspect-ratio: 2/3;
    object-fit: cover;
  }

  .film-poster-placeholder {
    grid-row: 1;
    aspect-ratio: 2/3;
    background-color: #d0d0d0;
  }

  .film-title {
    grid-row: 2;
    align-self: start;
    padding-top: 0.5rem;
    font-size: 0.9rem;
    text-wrap: pretty;
  }

  .film-year {
    grid-row: 3;
    align-self: start;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .film-character {
    grid-row: 4;
    align-self: start;
    font-size: 0.8rem;
    font-style: italic;
    opacity: 0.6;
  }
</style>
