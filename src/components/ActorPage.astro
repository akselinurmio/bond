---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getCollection, type CollectionEntry } from "astro:content";
import LangLayout from "layouts/LangLayout.astro";
import { getBondActorUrl } from "lib/actor-routes";
import { Temporal } from "temporal-polyfill";

interface Props {
  actor: CollectionEntry<"actors">;
  language: "en" | "fi";
}

const { actor, language } = Astro.props;
const localizedActor = actor.data.locales[language];

const title = localizedActor.name;
const canonical = getBondActorUrl(
  actor.data.tmdbId,
  localizedActor.slug,
  language,
);
const alternates = {
  en: getBondActorUrl(actor.data.tmdbId, actor.data.locales.en.slug, "en"),
  fi: getBondActorUrl(actor.data.tmdbId, actor.data.locales.fi.slug, "fi"),
};
const backLabel =
  language === "fi" ? "Takaisin etusivulle" : "Back to the front page";
const backHref = getAbsoluteLocaleUrl(language, "");

function formatDate(isoDate: string) {
  return {
    iso: isoDate,
    formatted: Temporal.PlainDate.from(isoDate).toLocaleString(
      language === "en" ? "en-GB" : language,
      { dateStyle: "long" },
    ),
  };
}

const birthday = actor.data.birthday ? formatDate(actor.data.birthday) : null;
const deathday = actor.data.deathday ? formatDate(actor.data.deathday) : null;
const movieCreditsByTmdbId = new Map(
  localizedActor.movieCredits.map((credit) => [credit.tmdbId, credit]),
);
const bondFilms = (await getCollection("bondFilms"))
  .toSorted((a, b) => a.data.listOrder - b.data.listOrder)
  .flatMap((film) => {
    const credit = movieCreditsByTmdbId.get(film.data.tmdbId);
    return credit ? [{ credit, film }] : [];
  });
const filmographyLabel =
  language === "fi"
    ? bondFilms.length === 1
      ? "Esiintynyt yhdessä Bond-elokuvassa"
      : `Esiintynyt ${bondFilms.length} Bond-elokuvassa`
    : bondFilms.length === 1
      ? "Appeared in one Bond film"
      : `Appeared in ${bondFilms.length} Bond films`;
---

<LangLayout
  title={title}
  canonical={canonical}
  alternates={alternates}
  localePaths={{
    en: `bonds/${actor.data.tmdbId}/${actor.data.locales.en.slug}`,
    fi: `bonds/${actor.data.tmdbId}/${actor.data.locales.fi.slug}`,
  }}
>
  <article class="actor-page">
    <a href={backHref} class="back-link">&larr; {backLabel}</a>

    <div class="actor-header">
      {
        actor.data.profileImage ? (
          <img
            alt={localizedActor.name}
            src={actor.data.profileImage.src}
            srcset={actor.data.profileImage.srcset}
            sizes="185px"
            width="185"
            height="278"
            class="actor-image"
          />
        ) : null
      }
      <div class="actor-info">
        <h1 translate="no">{localizedActor.name}</h1>
        {
          birthday && (
            <p class="actor-lifespan">
              {!deathday && (language === "fi" ? "s. " : "born ")}
              <time datetime={birthday.iso}>{birthday.formatted}</time>
              {deathday && (
                <>
                  {" \u{2013} "}
                  <time datetime={deathday.iso}>{deathday.formatted}</time>
                </>
              )}
            </p>
          )
        }
      </div>
    </div>

    {
      bondFilms.length > 0 ? (
        <section class="filmography">
          <h2>{filmographyLabel}</h2>
          <ul class="filmography-list">
            {bondFilms.map(({ credit, film }) => {
              const localizedFilm = film.data.locales[language];

              return (
                <li class="film-card">
                  {film.data.posterImage ? (
                    <img
                      alt={localizedFilm.title}
                      src={film.data.posterImage.src}
                      srcset={film.data.posterImage.srcset}
                      sizes="185px"
                      width="185"
                      height="277"
                      class="film-poster"
                      loading="lazy"
                    />
                  ) : (
                    <div class="film-poster-placeholder" />
                  )}
                  <strong class="film-title">{localizedFilm.title}</strong>
                  {film.data.releaseYear ? (
                    <span class="film-year">{film.data.releaseYear}</span>
                  ) : null}
                  {credit.character ? (
                    <span class="film-character">{credit.character}</span>
                  ) : null}
                </li>
              );
            })}
          </ul>
        </section>
      ) : null
    }
  </article>
</LangLayout>

<style>
  .actor-page {
    display: grid;
    gap: 2rem;
  }

  .back-link {
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }

  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
  }

  .actor-header {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 40rem) {
    .actor-header {
      grid-template-columns: auto 1fr;
    }
  }

  .actor-image {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .actor-info {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .actor-info h1 {
    margin: 0;
  }

  .actor-lifespan {
    margin: 0;
    font-style: italic;
    opacity: 0.8;
  }

  .filmography h2 {
    margin: 0 0 1rem;
  }

  .filmography-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    grid-auto-rows: auto auto auto auto 1rem;
    column-gap: 1rem;
    row-gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .film-card {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
  }

  .film-poster {
    grid-row: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2/3;
    object-fit: cover;
  }

  .film-poster-placeholder {
    grid-row: 1;
    aspect-ratio: 2/3;
    background-color: #d0d0d0;
  }

  .film-title {
    grid-row: 2;
    align-self: start;
    padding-top: 0.5rem;
    font-size: 0.9rem;
    text-wrap: pretty;
  }

  .film-year {
    grid-row: 3;
    align-self: start;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .film-character {
    grid-row: 4;
    align-self: start;
    font-size: 0.8rem;
    font-style: italic;
    opacity: 0.6;
  }
</style>
