---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import LangLayout from "layouts/LangLayout.astro";
import VoteForm from "components/VoteForm.astro";
import Top3 from "components/Top3.astro";
import { getVotesForAllBonds } from "lib/votes";

interface Props {
  language: "en" | "fi";
}

const { language } = Astro.props;

const [actors, votes] = await Promise.all([
  getCollection("actors"),
  getVotesForAllBonds(),
]);
const sortedActors = actors.sort(
  (actorA, actorB) => actorA.data.order - actorB.data.order,
);
const totalVotes = [...votes.values()].reduce((sum, v) => sum + v, 0);
const top3 = [...actors]
  .map((actor) => ({ actor, voteCount: votes.get(actor.data.tmdbId) ?? 0 }))
  .sort((a, b) => b.voteCount - a.voteCount)
  .slice(0, 3);
---

<LangLayout
  canonical={getAbsoluteLocaleUrl(language)}
  alternates={{
    en: getAbsoluteLocaleUrl("en"),
    fi: getAbsoluteLocaleUrl("fi"),
  }}
  localePaths={{
    en: "",
    fi: "",
  }}
>
  <section class="bonds">
    {
      sortedActors.map((actor) => {
        const localizedActor = actor.data.locales[language];
        const titleId = `bond-${actor.id}`;
        const actorPath = `/bonds/${actor.data.tmdbId}/${localizedActor.slug}`;

        return (
          <article aria-labelledby={titleId}>
            <a href={actorPath} class="bond-link" aria-labelledby={titleId}>
              {actor.data.profileImage ? (
                <img
                  alt={localizedActor.name}
                  src={actor.data.profileImage.src}
                  srcset={actor.data.profileImage.srcset}
                  sizes="185px"
                  width="185"
                  height="278"
                  class="bond-image"
                />
              ) : null}
              <h3 id={titleId} translate="no" class="bond-name">
                {localizedActor.name}
              </h3>
            </a>
            <VoteForm
              actorId={actor.data.tmdbId}
              actorName={localizedActor.name}
              language={language}
              votes={votes.get(actor.data.tmdbId) || 0}
            />
          </article>
        );
      })
    }
  </section>

  <Top3
    items={top3.map(({ actor, voteCount }) => {
      const { name, slug } = actor.data.locales[language];
      return {
        name,
        actorPath: `/bonds/${actor.data.tmdbId}/${slug}`,
        voteCount,
      };
    })}
    totalVotes={totalVotes}
    language={language}
  />
</LangLayout>

<style>
  .bonds {
    display: grid;
    column-gap: 0.5rem;
    row-gap: 2rem;
    grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
    justify-content: center;
    align-content: center;
  }

  .bond-image {
    display: block;
    object-fit: contain;
    max-width: 100%;
    height: auto;
  }

  .bond-link {
    color: inherit;
    display: block;
  }

  .bond-name {
    font-size: 1rem;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }
</style>
