---
import { getEntry } from "astro:content";
import ActorPage from "components/ActorPage.astro";

const language = "fi" as const;
const requestedActorId = Astro.params.actorId;
const requestedSlug = Astro.params.slug ?? "";

const actor = requestedActorId
  ? await getEntry("actors", requestedActorId)
  : undefined;

if (!actor) {
  Astro.response.status = 404;
} else {
  const canonicalSlug = actor.data.locales[language].slug;

  if (canonicalSlug !== requestedSlug) {
    return Astro.redirect(`/bonds/${actor.data.tmdbId}/${canonicalSlug}`, 301);
  }
}
---

{actor ? <ActorPage actor={actor} language={language} /> : null}
