---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import LangLayout from "layouts/LangLayout.astro";
import { stripTrailingSlash } from "lib/url-utils";
---

<LangLayout
  title="Tietoa"
  canonical={stripTrailingSlash(getAbsoluteLocaleUrl("fi", "about"))}
  alternates={{
    en: stripTrailingSlash(getAbsoluteLocaleUrl("en", "about")),
    fi: stripTrailingSlash(getAbsoluteLocaleUrl("fi", "about")),
  }}
  localePaths={{
    en: "about",
    fi: "about",
  }}
>
  <h1>Tietoa sivusta</h1>

  <h2>Kiitokset</h2>

  <p lang="en">
    <a href="https://www.themoviedb.org/" target="_blank">
      <img src="/tmdb.svg" alt="The Movie Database" width="248" height="18" />
    </a>
  </p>
  <p lang="en">
    This product uses the TMDB API but is not endorsed or certified by TMDB.
  </p>
</LangLayout>
